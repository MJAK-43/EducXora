{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write resources/js resources/css tests/Frontend *.js *.ts *.json .github/workflows",
        "format:check": "prettier --check resources/js resources/css tests/Frontend *.js *.ts *.json .github/workflows"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.2.0",
        "@lucide/vue": "^1.32.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.0",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.0",
        "eslint-plugin-vue": "^10.4.0",
        "globals": "^16.4.0",
        "jsdom": "^27.0.0",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.5.0",
        "postcss-preset-env": "^10.4.0",
        "prettier": "^3.6.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.46.0",
        "vite": "^8.0.0",
        "vitest": "^4.0.0",
        "vue-tsc": "^3.1.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
